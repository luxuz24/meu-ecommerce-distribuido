# ==========================================
# INFRASTRUCTURE CREDENTIALS & SETTINGS
# ==========================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5434

# MongoDB
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASS=admin

# RabbitMQ
RABBIT_USER=guest
RABBIT_PASS=guest

# ==========================================
# SERVICES CONFIGURATION
# ==========================================

# User Service
PORT=3000
JWT_SECRET=supersecretjwtkey_ecommerce_micro_2026
# Conta ADMIN provisionada no boot (o cadastro público só cria CUSTOMER)
ADMIN_EMAIL=admin@microstore.com
ADMIN_PASSWORD=AdminPassword123!

# Catalog Service
CATALOG_PORT=3001

# Inventory Service
INVENTORY_PORT=3003

# Order Service
ORDER_PORT=3004

# Payment Service
PAYMENT_PORT=3005

# CORS
# Somente o frontend chama a API (via gateway :8080); os serviços não são expostos no host
CORS_ORIGINS=http://localhost:3002,http://localhost:8080
