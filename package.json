{
  "name": "ecommerce-micro-monorepo",
  "version": "1.0.0",
  "description": "Distributed e-commerce microservices platform",
  "private": true,
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "test:user": "npm --prefix services/user-service test",
    "test:catalog": "npm --prefix services/catalog-service test",
    "test:inventory": "npm --prefix services/inventory-service test",
    "test:order": "npm --prefix services/order-service test",
    "test:payment": "npm --prefix services/payment-service test",
    "test:outbox": "npm --prefix services/user-outbox-processor test",
    "test:notification": "npm --prefix services/notification-service test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:user && npm run test:catalog && npm run test:inventory && npm run test:order && npm run test:payment && npm run test:outbox && npm run test:notification && npm run test:frontend",
    "build:user": "npm --prefix services/user-service run build",
    "build:catalog": "npm --prefix services/catalog-service run build",
    "build:inventory": "npm --prefix services/inventory-service run build",
    "build:order": "npm --prefix services/order-service run build",
    "build:payment": "npm --prefix services/payment-service run build",
    "build:outbox": "npm --prefix services/user-outbox-processor run build",
    "build:notification": "npm --prefix services/notification-service run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:user && npm run build:catalog && npm run build:inventory && npm run build:order && npm run build:payment && npm run build:outbox && npm run build:notification && npm run build:frontend",
    "seed:demo": "npx --yes tsx scripts/seed-demo.ts",
    "test:e2e": "npx --yes tsx scripts/e2e-saga.ts",
    "test:chaos": "bash scripts/chaos/reservation-expiry.sh",
    "lint": "eslint services/*/src frontend/src scripts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
