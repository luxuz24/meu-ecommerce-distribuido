{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-support/**",
    "!src/server.ts",
    "!src/infra/database/prisma.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "concurrency": 4,
  "tsconfigFile": "tsconfig.stryker-none.json"
}
